    <rdfs:comment xml:lang="en">Class generated from source table 'observations'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical observation recorded for a patient, typically during an encounter. Examples include a vital sign, a laboratory result or a survey score. Each observation is identified by a clinical code with a textual description. It may carry a numeric value with units of measure. Derived from source table 'observations'. The table has no primary key and all columns are nullable.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/observations"/>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Unnamed"/>
  </rdf:Description>
