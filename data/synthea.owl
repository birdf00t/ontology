  <rdf:Description rdf:about="http://example.org/ontology#procedures_REASONCODE">
    <rdfs:label xml:lang="en">REASONCODE</rdfs:label>
    <rdfs:label xml:lang="en">procedure reason code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Procedures"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/procedures/REASONCODE"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'procedures.REASONCODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Numeric clinical terminology code (likely a SNOMED CT concept identifier) for the condition or reason motivating the procedure. Nominal identifier code, not ordinal; its meaning is given by procedures.REASONDESCRIPTION. Analogous to encounters_REASONCODE and medications_REASONCODE. Source column procedures.REASONCODE; datatype xsd:integer; nullable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#conditions_CODE">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions/CODE"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'conditions.CODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Clinical terminology code identifying the condition (likely a SNOMED CT concept identifier). Source column conditions.CODE, datatype xsd:integer. This is a nominal identifier, not an ordinal or quantitative value, so arithmetic or ordering on it is not meaningful. The human-readable term is given by the linked prevalence item (DESCRIPTION column).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Conditions"/>
    <rdfs:label xml:lang="en">CODE</rdfs:label>
    <rdfs:label xml:lang="en">condition code</rdfs:label>
    <rdfs:label xml:lang="en">conditions CODE</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N17b407d7a810492e96db37bfc41349c2">
