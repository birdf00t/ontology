  <rdf:Description rdf:about="http://example.org/ontology#observations_hasEncounters">
    <rdfs:range rdf:resource="http://example.org/ontology#Encounters"/>
    <rdfs:label xml:lang="en">observations has Encounters</rdfs:label>
    <rdfs:label xml:lang="en">observation recorded in encounter</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Observations"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/observations/ENCOUNTER"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'observations.ENCOUNTER' referencing 'encounters.ID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an observation to the clinical encounter during which it was recorded. This is a foreign-key relationship from observations.ENCOUNTER to encounters.ID. The source column is nullable, so no existential restriction is asserted. Each row holds at most one encounter reference.</rdfs:comment>
  </rdf:Description>
