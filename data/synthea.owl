  <rdf:Description rdf:about="http://example.org/ontology#all_prevalences_PREVALENCE_RATE">
    <rdfs:domain rdf:resource="http://example.org/ontology#AllPrevalences"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'all_prevalences.PREVALENCE RATE' with range xsd:double.</rdfs:comment>
    <rdfs:comment xml:lang="en">Prevalence expressed as a proportion, typically OCCURRENCES divided by POPULATION COUNT (expected range 0 to 1). Optional. Source column all_prevalences.PREVALENCE RATE; datatype xsd:double.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/all_prevalences/PREVALENCE%20RATE"/>
    <rdfs:label xml:lang="en">PREVALENCE RATE</rdfs:label>
    <rdfs:label xml:lang="en">all prevalences PREVALENCE RATE</rdfs:label>
    <rdfs:label xml:lang="en">prevalence rate</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
