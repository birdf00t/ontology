    <rdfs:comment xml:lang="en">Class generated from source table 'patients'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person who receives or has received healthcare services. Each instance corresponds to one row of the source table 'patients' and is uniquely identified by the patient identifier (primary key column patients.patient). The record holds demographic, identification, naming, and residence information.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person receiving healthcare services. Instances correspond to rows of the source table 'patients'. This class is referenced by encounters.PATIENT.</rdfs:comment>
    <rdfs:comment xml:lang="en">A patient record from the source table 'patients', identified by the primary key column patients.patient.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'patients'; referenced by conditions.PATIENT.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person receiving care. Each instance corresponds to a row of the source table 'patients'. It is referenced here as the target of the immunization-to-patient foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person receiving care, derived from source table 'patients'. Referenced here as the target of the medications.PATIENT foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'patients'; a person who receives clinical care.</rdfs:comment>
    <rdfs:label xml:lang="en">Patients</rdfs:label>
    <rdfs:label xml:lang="en">Patient</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients"/>
    <owl:hasKey rdf:nodeID="N63ff6063e80c4d53ac47156c30f5fa0c"/>
    <owl:hasKey rdf:nodeID="N88f5bfc2bbdb422aad82ca06a239fc2e"/>
  </rdf:Description>
