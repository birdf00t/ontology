  <rdf:Description rdf:about="http://example.org/ontology#observations_hasPatients">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/observations/PATIENT"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'observations.PATIENT' referencing 'patients.patient'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an observation to the patient it was recorded for. This is a foreign-key relationship from observations.PATIENT to patients.patient. The source column is nullable, so no existential restriction is asserted. Each row holds at most one patient reference.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Observations"/>
    <rdfs:label xml:lang="en">observations has Patients</rdfs:label>
    <rdfs:label xml:lang="en">observation of patient</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#Patients"/>
  </rdf:Description>
