  <rdf:Description rdf:about="http://example.org/ontology#patients_ssn">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients/ssn"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.ssn' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Social Security Number of the patient, a national identification number. This is sensitive personal data. Derived from column patients.ssn (nullable). Datatype: xsd:string.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">ssn</rdfs:label>
    <rdfs:label xml:lang="en">social security number</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#all_prevalences_OCCURRENCES">
    <rdfs:comment xml:lang="en">Data property generated from source column 'all_prevalences.OCCURRENCES' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Count of individuals or instances in the reference population for which the item occurs. This is a quantitative count (numerator of the prevalence), not a categorical code. Optional. Source column all_prevalences.OCCURRENCES; datatype xsd:integer.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">OCCURRENCES</rdfs:label>
    <rdfs:label xml:lang="en">occurrences</rdfs:label>
    <rdfs:label xml:lang="en">all prevalences OCCURRENCES</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/all_prevalences/OCCURRENCES"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#AllPrevalences"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patients_prefix">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients/prefix"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.prefix' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Honorific or title preceding the patient's name, for example Mr., Mrs., Ms., or Dr. This is a categorical text value. Derived from column patients.prefix (nullable). Datatype: xsd:string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:label xml:lang="en">prefix</rdfs:label>
    <rdfs:label xml:lang="en">name prefix</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergies_hasPatients">
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergies"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'allergies.PATIENT' referencing 'patients.patient'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an allergy record to the patient who has the allergy. Derived from the foreign key allergies.PATIENT, which references patients.patient. The column is mandatory (NOT NULL) and is part of the composite primary key, so every allergy record refers to exactly one patient.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:label xml:lang="en">allergies has Patients</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/allergies/PATIENT"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Careplans">
    <rdfs:comment xml:lang="en">Class generated from source table 'careplans'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A care plan record, derived from source table 'careplans'. It describes a planned course of clinical care for a patient. The plan may be initiated during a clinical encounter. It has a start date, an optional stop date, a coded care plan type, and an optional coded reason. Each row corresponds to one care plan instance. The ID column is nullable and not declared unique, so it is not modeled as a key.</rdfs:comment>
    <rdfs:subClassOf rdf:nodeID="Nc98c037a5dc94d8786c33bc7e1a76029"/>
    <rdfs:subClassOf rdf:nodeID="Nd41da3be25bb4663a5d353b64ca5c337"/>
