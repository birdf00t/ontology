  <rdf:Description rdf:about="http://example.org/ontology#allergies_CODE">
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergies"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'allergies.CODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical terminology code that identifies the allergy type, from column allergies.CODE. In Synthea-style data this is typically a SNOMED CT concept identifier. It is a nominal identifier, not an ordinal or quantitative value, so arithmetic or ordering on it has no meaning. The value is mandatory and is part of the composite primary key. Its human-readable meaning is given by allergies_DESCRIPTION.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/allergies/CODE"/>
