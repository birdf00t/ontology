  <rdf:Description rdf:about="http://example.org/ontology#allergies_hasEncounters">
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'allergies.ENCOUNTER' referencing 'encounters.ID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an allergy record to the clinical encounter during which the allergy was diagnosed or recorded. Derived from the foreign key allergies.ENCOUNTER, which references encounters.ID. The column is mandatory (NOT NULL) and is part of the composite primary key, so every allergy record refers to exactly one encounter.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#Encounters"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/allergies/ENCOUNTER"/>
    <rdfs:label xml:lang="en">allergies has Encounters</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergies"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ndf7ca53b9b244237906298fad8f7e956">
    <owl:onProperty rdf:resource="http://example.org/ontology#encounters_CODE"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medications_REASONCODE">
    <rdfs:label xml:lang="en">REASONCODE</rdfs:label>
    <rdfs:label xml:lang="en">medication reason code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'medications.REASONCODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Coded clinical reason (e.g. diagnosis or condition) for which the medication was prescribed (column medications.REASONCODE). The integer is a nominal code from a clinical terminology (likely SNOMED CT), not an ordinal or quantitative value. Its human-readable meaning is given by medications_REASONDESCRIPTION. Nullable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medications"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/medications/REASONCODE"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#all_prevalences_POPULATION_COUNT">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/all_prevalences/POPULATION%20COUNT"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#AllPrevalences"/>
    <rdfs:label xml:lang="en">POPULATION COUNT</rdfs:label>
    <rdfs:label xml:lang="en">population count</rdfs:label>
    <rdfs:label xml:lang="en">all prevalences POPULATION COUNT</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'all_prevalences.POPULATION COUNT' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Total size of the reference population used as the denominator when computing prevalence. This is a quantitative count, not a categorical code. Optional. Source column all_prevalences.POPULATION COUNT; datatype xsd:integer.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#observations_DATE">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'observations.DATE' with range xsd:date.</rdfs:comment>
    <rdfs:comment xml:lang="en">The calendar date on which the observation was recorded or performed. Source column observations.DATE has datatype xsd:date and is nullable.</rdfs:comment>
    <rdfs:label xml:lang="en">DATE</rdfs:label>
    <rdfs:label xml:lang="en">observations DATE</rdfs:label>
    <rdfs:label xml:lang="en">observation date</rdfs:label>
