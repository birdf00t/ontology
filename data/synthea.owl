  <rdf:Description rdf:about="http://example.org/ontology#all_prevalences_POPULATION_TYPE">
    <rdfs:label xml:lang="en">POPULATION TYPE</rdfs:label>
    <rdfs:label xml:lang="en">all prevalences POPULATION TYPE</rdfs:label>
    <rdfs:label xml:lang="en">population type</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/all_prevalences/POPULATION%20TYPE"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#AllPrevalences"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'all_prevalences.POPULATION TYPE' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Categorical label describing the reference population over which the prevalence was computed (e.g. a living or all-patients population). Stored as free text; no closed value list is documented in the source. Optional. Source column all_prevalences.POPULATION TYPE; datatype xsd:string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
