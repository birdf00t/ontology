    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.maiden' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Family name of the patient before marriage, where applicable. Derived from column patients.maiden (nullable). Datatype: xsd:string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients/maiden"/>
  </rdf:Description>
