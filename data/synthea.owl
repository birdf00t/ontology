    <rdfs:comment xml:lang="en">Human-readable description of the observation type associated with the observation code. Source column observations.DESCRIPTION has datatype xsd:string and is nullable.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/observations/DESCRIPTION"/>
    <rdfs:label xml:lang="en">DESCRIPTION</rdfs:label>
