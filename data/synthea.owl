  <rdf:Description rdf:about="http://example.org/ontology#allergies_STOP">
    <rdfs:label xml:lang="en">STOP</rdfs:label>
    <rdfs:label xml:lang="en">allergies STOP</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/allergies/STOP"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'allergies.STOP' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">The date on which the allergy was resolved or ceased to be active, from column allergies.STOP. The source schema types this column as a string, so the range is xsd:string to stay consistent with the direct mapping; values are expected in a date format and should be retyped to xsd:date upstream. The value is optional; if it is absent, the allergy may still be active.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergies"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#allergies_DESCRIPTION">
    <rdfs:domain rdf:resource="http://example.org/ontology#Allergies"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'allergies.DESCRIPTION' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">A human-readable description of the allergy that corresponds to the code in allergies_CODE, from column allergies.DESCRIPTION. The value is optional (nullable).</rdfs:comment>
    <rdfs:label xml:lang="en">DESCRIPTION</rdfs:label>
    <rdfs:label xml:lang="en">allergies DESCRIPTION</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/allergies/DESCRIPTION"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#encounters_hasPatients">
    <rdfs:domain rdf:resource="http://example.org/ontology#Encounters"/>
    <rdfs:label xml:lang="en">encounters has Patients</rdfs:label>
    <rdfs:label xml:lang="en">encounter has patient</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/encounters/PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'encounters.PATIENT' referencing 'patients.patient'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an encounter to the patient who took part in it. This property is derived from the foreign key encounters.PATIENT, which references patients.patient. Each encounter row refers to at most one patient.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N2d4f588063044f48965bf4a26f591492">
