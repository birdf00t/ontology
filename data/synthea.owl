    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Immunizations</rdfs:label>
    <rdfs:label xml:lang="en">Immunization</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'immunizations'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A record of a vaccine administered to a patient on a given date during a clinical encounter. Each instance corresponds to one row of the source table 'immunizations'. A record is identified by the composite primary key (DATE, PATIENT, ENCOUNTER, CODE).</rdfs:comment>
