    <rdfs:comment xml:lang="en">Date on which the condition was first recorded or diagnosed (onset date). Source column conditions.START, datatype xsd:date. The column is nullable, and each condition has at most one start date.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions/START"/>
