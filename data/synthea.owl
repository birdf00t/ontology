  <rdf:Description rdf:about="http://example.org/ontology#observations_CODE">
    <rdfs:comment xml:lang="en">Data property generated from source column 'observations.CODE' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical terminology code identifying the kind of observation. It is likely a LOINC-style code, and this is not confirmed by documentation. The code is stored as a string (xsd:string) because codes may contain non-numeric characters such as hyphens. Source column is observations.CODE and is nullable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Observations"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
