  <rdf:Description rdf:about="http://example.org/ontology#encounters_REASONCODE">
    <rdfs:label xml:lang="en">REASONCODE</rdfs:label>
    <rdfs:label xml:lang="en">encounter reason code</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Encounters"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'encounters.REASONCODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Coded reason for the encounter, such as a diagnosis or condition (column encounters.REASONCODE). The value is a nominal identifier from a clinical terminology, such as a SNOMED CT concept identifier. It is not an ordinal or quantitative value. Its human-readable meaning is given by encounters.REASONDESCRIPTION. The value is optional. Datatype xsd:integer.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/encounters/REASONCODE"/>
  </rdf:Description>
