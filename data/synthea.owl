  <rdf:Description rdf:about="http://example.org/ontology#conditions_hasPatients">
    <rdfs:range rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Conditions"/>
    <rdfs:label xml:lang="en">conditions has Patients</rdfs:label>
    <rdfs:label xml:lang="en">condition of patient</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions/PATIENT"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'conditions.PATIENT' referencing 'patients.patient'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a condition to the patient who has it. Foreign-key relationship from conditions.PATIENT to patients.patient. The column is nullable, and each condition refers to at most one patient.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#careplans_REASONCODE">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'careplans.REASONCODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Clinical terminology code for the condition or reason motivating the care plan, likely a SNOMED CT concept identifier. From column careplans.REASONCODE (xsd:integer). This is a categorical (nominal) code, not an ordinal or quantitative value. The human-readable meaning is given by careplans_REASONDESCRIPTION. The column is nullable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplans"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/careplans/REASONCODE"/>
    <rdfs:label xml:lang="en">REASONCODE</rdfs:label>
    <rdfs:label xml:lang="en">care plan reason code</rdfs:label>
  </rdf:Description>
