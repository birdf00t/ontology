  <rdf:Description rdf:about="http://example.org/ontology#patients_race">
    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.race' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Self-reported or recorded race of the patient. This is a categorical text value, for example 'white', 'black', 'asian', 'native', or 'other'. Derived from column patients.race (nullable). Datatype: xsd:string.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patients"/>
