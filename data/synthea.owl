  <rdf:Description rdf:about="http://example.org/ontology#patients_marital">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients/marital"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:label xml:lang="en">marital</rdfs:label>
    <rdfs:label xml:lang="en">marital status</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.marital' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Marital status of the patient. This is a categorical code stored as text, typically single-letter codes such as 'M' (married) or 'S' (single); other codes may occur. Derived from column patients.marital (nullable). Datatype: xsd:string.</rdfs:comment>
  </rdf:Description>
