    <rdfs:label xml:lang="en">procedure code</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'procedures.CODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Numeric clinical terminology code identifying the type of procedure (likely a SNOMED CT concept identifier). This is a nominal identifier code, not an ordinal or quantitative value; its meaning is given by procedures.DESCRIPTION. Source column procedures.CODE; datatype xsd:integer; nullable.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Procedures"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
