  <rdf:Description rdf:about="http://example.org/ontology#all_prevalences_PREVALENCE_PERCENTAGE">
    <rdfs:label xml:lang="en">PREVALENCE PERCENTAGE</rdfs:label>
    <rdfs:label xml:lang="en">prevalence percentage</rdfs:label>
    <rdfs:label xml:lang="en">all prevalences PREVALENCE PERCENTAGE</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'all_prevalences.PREVALENCE PERCENTAGE' with range xsd:double.</rdfs:comment>
    <rdfs:comment xml:lang="en">Prevalence expressed as a percentage, typically PREVALENCE RATE multiplied by 100 (expected range 0 to 100). Optional. Source column all_prevalences.PREVALENCE PERCENTAGE; datatype xsd:double.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#double"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#AllPrevalences"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/all_prevalences/PREVALENCE%20PERCENTAGE"/>
  </rdf:Description>
