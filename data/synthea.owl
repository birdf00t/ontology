    <rdfs:comment xml:lang="en">Data property generated from source column 'claims.DIAGNOSIS' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Diagnosis code or description justifying the claimed services. Derived from column claims.DIAGNOSIS (xsd:string, nullable).</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Claims"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/claims/DIAGNOSIS"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">DIAGNOSIS</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#Conditions">
    <rdfs:label xml:lang="en">Conditions</rdfs:label>
    <rdfs:label xml:lang="en">Condition</rdfs:label>
    <rdfs:subClassOf rdf:nodeID="N62f61c6fd76943a0b41b37332b326865"/>
    <rdfs:subClassOf rdf:nodeID="N14d4cb9cb288421991dc4ebcdaab9b26"/>
    <rdfs:subClassOf rdf:nodeID="N236cd1a6d92d42bc89d722c9e5613618"/>
    <rdfs:subClassOf rdf:nodeID="N9e8a7c60eb1846cfb3c837ac3ff13487"/>
    <rdfs:subClassOf rdf:nodeID="N5fcdd58fa0e644439fa4f0e3cca547a2"/>
    <rdfs:subClassOf rdf:nodeID="Nc34255506b754b3880a0a4bf4a325971"/>
    <rdfs:subClassOf rdf:resource="http://example.org/ontology#Unnamed"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Class generated from source table 'conditions'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical condition (diagnosis or health problem) recorded for a patient, optionally in the context of a specific encounter. It has an onset (START) date and an optional resolution (STOP) date. Each record corresponds to one row of the source table 'conditions'.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medications_START">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/medications/START"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medications"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">START</rdfs:label>
    <rdfs:label xml:lang="en">medication start</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'medications.START' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Start date of the medication record (column medications.START). Stored as xsd:string in the source, although it semantically represents a date. Not nullable; part of the composite primary key.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#medications_DESCRIPTION">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/medications/DESCRIPTION"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Medications"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'medications.DESCRIPTION' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Human-readable description of the medication identified by medications_CODE (column medications.DESCRIPTION). Nullable.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">DESCRIPTION</rdfs:label>
    <rdfs:label xml:lang="en">medication description</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#immunizations_CODE">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'immunizations.CODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Coded identifier of the vaccine administered. Source column immunizations.CODE (xsd:integer). This column is not null and is part of the composite primary key. The integer is a nominal categorical code drawn from a vaccine coding system (e.g. a CVX-style code). It has no ordinal or arithmetic meaning. The human-readable meaning is given by immunizations_DESCRIPTION.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/immunizations/CODE"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">CODE</rdfs:label>
    <rdfs:label xml:lang="en">immunization vaccine code</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Immunizations"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nb00d811b17f442b48db2aa7582ae3fed">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:onProperty rdf:resource="http://example.org/ontology#procedures_CODE"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#patients_deathdate">
    <rdfs:label xml:lang="en">deathdate</rdfs:label>
    <rdfs:label xml:lang="en">death date</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/patients/deathdate"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'patients.deathdate' with range xsd:date.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date on which the patient died. Derived from column patients.deathdate. The column is nullable, and an absent value typically indicates that the patient is living or that the date of death is unknown. Datatype: xsd:date.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Patients"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#date"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#procedures_hasPatients">
    <rdfs:domain rdf:resource="http://example.org/ontology#Procedures"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/procedures/PATIENT"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Patients"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'procedures.PATIENT' referencing 'patients.patient'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a procedure to the patient on whom it was performed. Foreign-key relationship from procedures.PATIENT to patients.patient; nullable.</rdfs:comment>
    <rdfs:label xml:lang="en">procedures has Patients</rdfs:label>
    <rdfs:label xml:lang="en">procedure performed on patient</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#careplans_ID">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:label xml:lang="en">ID</rdfs:label>
    <rdfs:label xml:lang="en">care plan identifier</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Careplans"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'careplans.ID' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Source identifier of the care plan, from column careplans.ID (xsd:string). The column is nullable and not declared unique or primary key, so no existential or key restriction is asserted.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/careplans/ID"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Ne73197fbb7b749e2af9c3e02b69125b2">
