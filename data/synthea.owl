    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
    <owl:allValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#conditions_hasAllPrevalences">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:label xml:lang="en">conditions has All Prevalences</rdfs:label>
    <rdfs:label xml:lang="en">condition has prevalence item</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#AllPrevalences"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Conditions"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions/DESCRIPTION"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'conditions.DESCRIPTION' referencing 'all_prevalences.ITEM'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a condition to the prevalence statistics entry whose ITEM matches the condition's textual description. Foreign-key relationship from conditions.DESCRIPTION to all_prevalences.ITEM. The DESCRIPTION column holds the human-readable condition name and is modeled only via this object property. The column is nullable, and each condition refers to at most one prevalence item.</rdfs:comment>
  </rdf:Description>
