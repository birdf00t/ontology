  <rdf:Description rdf:about="http://example.org/ontology#encounters_CODE">
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/encounters/CODE"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'encounters.CODE' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Coded classification of the encounter type (column encounters.CODE). The value is a nominal identifier from a clinical terminology, such as a SNOMED CT concept identifier. It is not an ordinal or quantitative value, so arithmetic or ordering comparisons are not meaningful. Its human-readable meaning is given by encounters.DESCRIPTION. Datatype xsd:integer.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">CODE</rdfs:label>
    <rdfs:label xml:lang="en">encounter type code</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Encounters"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#conditions_hasEncounters">
    <rdfs:range rdf:resource="http://example.org/ontology#Encounters"/>
    <rdfs:label xml:lang="en">conditions has Encounters</rdfs:label>
    <rdfs:label xml:lang="en">condition recorded during encounter</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/conditions/ENCOUNTER"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'conditions.ENCOUNTER' referencing 'encounters.ID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a condition to the clinical encounter during which it was diagnosed or recorded. Foreign-key relationship from conditions.ENCOUNTER to encounters.ID. The column is nullable, and each condition refers to at most one encounter.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Conditions"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
