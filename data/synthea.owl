  <rdf:Description rdf:about="http://example.org/ontology#immunizations_hasEncounters">
    <rdfs:domain rdf:resource="http://example.org/ontology#Immunizations"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'immunizations.ENCOUNTER' referencing 'encounters.ID'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an immunization record to the clinical encounter during which the vaccine was administered. This is the foreign key immunizations.ENCOUNTER referencing encounters.ID. The column is not null and is part of the composite primary key.</rdfs:comment>
    <rdfs:label xml:lang="en">immunizations has Encounters</rdfs:label>
    <rdfs:label xml:lang="en">immunization during encounter</rdfs:label>
    <rdfs:range rdf:resource="http://example.org/ontology#Encounters"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/immunizations/ENCOUNTER"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
