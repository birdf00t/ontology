    <rdfs:label xml:lang="en">Encounters</rdfs:label>
    <rdfs:label xml:lang="en">Encounter</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'encounters'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical encounter is an interaction between a patient and a healthcare provider on a given date, such as a visit, consultation, admission, or check-up. Each instance corresponds to one row of the source table 'encounters' and is identified by encounters.ID.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical encounter record from the source table 'encounters', identified by the primary key column encounters.ID.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'encounters'; referenced by conditions.ENCOUNTER.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical encounter between a patient and a healthcare provider. Each instance corresponds to a row of the source table 'encounters'. It is referenced here as the target of the immunization-to-encounter foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">A clinical encounter (visit or contact) between a patient and the healthcare system, derived from source table 'encounters'. Referenced here as the target of the medications.ENCOUNTER foreign key.</rdfs:comment>
    <rdfs:comment xml:lang="en">Class generated from source table 'encounters'; a clinical encounter or visit between a patient and a healthcare provider.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/encounters"/>
    <owl:hasKey rdf:nodeID="N4df4fc5510ae4093948229184d54b4ea"/>
    <owl:hasKey rdf:nodeID="N1c4ac18b142d401a8ea0a1e35d1309b5"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Patients"/>
  </rdf:Description>
