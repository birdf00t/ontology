    <rdfs:comment xml:lang="en">Data property generated from source column 'actor.actor_id' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Surrogate primary-key identifier of an actor. It is mandatory and uniquely identifies each actor; it is an opaque identifier, not a categorical or ordinal encoding. Source column actor.actor_id (xsd:integer, NOT NULL, PRIMARY KEY).</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#Actor"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/actor/actor_id"/>
  </rdf:Description>
