    <rdfs:label xml:lang="en">City</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'city'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A city or town, used as a geographic location for addresses. Each city is identified by a unique integer identifier, has a name, belongs to exactly one country, and records the timestamp of its last modification. Derived from source table 'city'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A city or town that addresses are located in. Generated from source table 'city'.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/city"/>
  </rdf:Description>
