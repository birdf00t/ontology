    <rdfs:comment xml:lang="en">Timestamp at which the country record was last modified in the source database (column country.last_update, not null). Record-maintenance metadata; the source datatype 'xsd:datetime' is normalized to the standard XSD datatype xsd:dateTime.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/country/last_update"/>
