    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'film_category.category_id' referencing 'category.category_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a film-category assignment to the category, such as a genre, that is assigned to the film. Derived from the non-null foreign key film_category.category_id, which references category.category_id. This property is part of the composite primary key of film_category. Each assignment refers to exactly one category.</rdfs:comment>
    <rdfs:range rdf:resource="http://example.org/ontology#Category"/>
  </rdf:Description>
