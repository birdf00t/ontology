  <rdf:Description rdf:about="http://example.org/ontology#film_hasLanguage">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/language_id"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Language"/>
    <rdfs:label xml:lang="en">film has Language</rdfs:label>
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'film.language_id' referencing 'language.language_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a film to the language in which it is presented, such as its spoken or dubbed language. Derived from the mandatory foreign key film.language_id, which references language.language_id. Every film has exactly one such language.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
