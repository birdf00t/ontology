    <rdfs:comment xml:lang="en">Data property generated from source column 'film_category.last_update' with range xsd:datetime.</rdfs:comment>
    <rdfs:comment xml:lang="en">The timestamp of the most recent modification of this film-category assignment record. Derived from the non-null column film_category.last_update. This is record-maintenance metadata and does not describe the film or the category itself.</rdfs:comment>
    <rdfs:domain rdf:resource="http://example.org/ontology#FilmCategory"/>
