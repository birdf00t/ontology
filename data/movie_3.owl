    <rdfs:comment xml:lang="en">Data property generated from source column 'staff.email' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Optional email address of the staff member. Source column: staff.email; datatype xsd:string; nullable.</rdfs:comment>
    <rdfs:label xml:lang="en">email</rdfs:label>
