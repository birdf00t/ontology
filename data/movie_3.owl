    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Film"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'inventory.film_id' referencing 'film.film_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links an inventory item to the film of which it is a physical copy. Every inventory item refers to exactly one film; a film may have many inventory copies. Derived from foreign key inventory.film_id (NOT NULL) referencing film.film_id.</rdfs:comment>
  </rdf:Description>
