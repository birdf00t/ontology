    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Inventory</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'inventory'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A single physical copy of a film held in stock at a specific store. Each inventory item is uniquely identified by its inventory_id. It references exactly one film (the title it is a copy of) and exactly one store (where the copy is stocked). Derived from source table 'inventory'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A physical inventory item (copy of a film held at a store) that can be rented. Target of the foreign key rental.inventory_id.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/inventory"/>
