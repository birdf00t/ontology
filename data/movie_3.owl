    <rdfs:label xml:lang="en">film id</rdfs:label>
    <rdfs:label xml:lang="en">film film id</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'film.film_id' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary-key surrogate identifier of a film (column film.film_id). It is mandatory and unique per film, and is used as the key of class Film. Datatype xsd:integer.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/film_id"/>
