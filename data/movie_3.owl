  <rdf:Description rdf:about="http://example.org/ontology#film_hasOriginalLanguage">
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'film.original_language_id' referencing 'language.language_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a film to the language in which it was originally produced, when that language differs from or is recorded separately from its presentation language. Derived from the optional foreign key film.original_language_id, which references language.language_id. A film has at most one original language.</rdfs:comment>
    <rdfs:label xml:lang="en">film has Original Language</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/original_language_id"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Language"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
