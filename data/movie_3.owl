  <rdf:Description rdf:about="http://example.org/ontology#film_length">
    <rdfs:comment xml:lang="en">Data property generated from source column 'film.length' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">The running time of the film (column film.length). It is a duration measure, typically in minutes, not a categorical code. This value is optional. Datatype xsd:integer.</rdfs:comment>
