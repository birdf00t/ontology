    <rdfs:subClassOf rdf:resource="http://example.org/ontology#film_hasOriginalLanguage_max_1_Language"/>
    <rdfs:subClassOf rdf:nodeID="Nf20a51f49c8f4b0badcdcef10c13774b"/>
