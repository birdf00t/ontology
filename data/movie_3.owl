    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:label xml:lang="en">Language</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'language'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language that can be associated with other records in the database, such as the language of a film. Each language is identified by its language id and has a mandatory name and last-update timestamp.</rdfs:comment>
    <rdfs:comment xml:lang="en">A natural language in which a film can be spoken or originally produced. Derived from source table 'language' and referenced by the foreign keys film.language_id and film.original_language_id.</rdfs:comment>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#film_release_year">
    <rdfs:label xml:lang="en">release year</rdfs:label>
    <rdfs:label xml:lang="en">film release year</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/release_year"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'film.release_year' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">The year in which the film was released (column film.release_year). This value is optional. It is stored as a string in the source and represents a four-digit calendar year; xsd:gYear is a candidate refinement once source typing is corrected. Datatype xsd:string.</rdfs:comment>
  </rdf:Description>
