  <rdf:Description rdf:about="http://example.org/ontology#store_hasManagerStaff">
    <rdfs:domain rdf:resource="http://example.org/ontology#Store"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Staff"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'store.manager_staff_id' referencing 'staff.staff_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Relates a store to the staff member who manages it. Derived from the foreign key store.manager_staff_id referencing staff.staff_id. The column is not null and unique, so every store has exactly one manager and a staff member manages at most one store.</rdfs:comment>
    <rdfs:label xml:lang="en">store has Manager Staff</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/store/manager_staff_id"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#country_country">
    <rdfs:comment xml:lang="en">Data property generated from source column 'country.country' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Human-readable name of the country (column country.country, not null). Each country has exactly one recorded name.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">country</rdfs:label>
    <rdfs:label xml:lang="en">country name</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/country/country"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Country"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#city_hasCountry">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Country"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#City"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/city/country_id"/>
    <rdfs:label xml:lang="en">city has Country</rdfs:label>
    <rdfs:label xml:lang="en">city has country</rdfs:label>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'city.country_id' referencing 'country.country_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Relates a city to the country in which it is located. Derived from the not-null foreign key city.country_id referencing country.country_id. Every city is located in exactly one country.</rdfs:comment>
  </rdf:Description>
