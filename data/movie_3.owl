  <rdf:Description rdf:about="http://example.org/ontology#customer_create_date">
    <rdfs:comment xml:lang="en">Data property generated from source column 'customer.create_date' with range xsd:datetime.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp at which the customer record was created (column customer.create_date; not null). The source type 'xsd:datetime' is normalized to the standard XSD datatype xsd:dateTime; the non-standard xsd:datetime axioms must be replaced in the core.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
