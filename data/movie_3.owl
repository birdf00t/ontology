    <rdfs:subClassOf rdf:nodeID="N42e5f8fea5da4446aa7a8c86d2d57241"/>
    <rdfs:comment xml:lang="en">Class generated from source table 'film'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A motion picture title in the rental catalogue. Each film is identified by film_id. It has a title, an optional description, and an optional release year. It has a mandatory spoken language and an optional original language. Rental terms include a rental duration and a rental rate. It has an optional running length, a replacement cost, an optional audience rating, optional special features, and a last-update timestamp. Derived from source table 'film'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A film title available in the catalogue. Individual physical copies of a film are represented as Inventory items. Derived from source table 'film'.</rdfs:comment>
    <owl:hasKey rdf:nodeID="N71e7fa294bcd4de286fb50a8889990f0"/>
    <owl:hasKey rdf:nodeID="N61cf8d88665947e891c703da14f39832"/>
    <rdfs:label xml:lang="en">Film</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#film_special_features">
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/special_features"/>
    <rdfs:label xml:lang="en">special features</rdfs:label>
    <rdfs:label xml:lang="en">film special features</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'film.special_features' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">The bonus content included with the film (column film.special_features). This value is optional. It is a categorical, possibly multi-valued list stored as a single string, typically drawn from: Trailers, Commentaries, Deleted Scenes, Behind the Scenes. Datatype xsd:string.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#staff_username">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/staff/username"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Staff"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">username</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'staff.username' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Login name the staff member uses to access the rental system. Source column: staff.username; datatype xsd:string; NOT NULL.</rdfs:comment>
  </rdf:Description>
