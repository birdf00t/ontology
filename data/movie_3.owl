    <rdfs:comment xml:lang="en">Timestamp of the most recent modification of the film record (column film.last_update). This is record-maintenance metadata and is mandatory. Datatype xsd:dateTime; this replaces the invalid xsd:datetime emitted by the Direct Mapping.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
