  <rdf:Description rdf:about="http://example.org/ontology#staff_active">
    <rdfs:domain rdf:resource="http://example.org/ontology#Staff"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:label xml:lang="en">active</rdfs:label>
    <rdfs:label xml:lang="en">active flag</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/staff/active"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'staff.active' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Boolean-like categorical integer flag that indicates whether the staff member is currently active. Encoding: 1 = active (currently employed); 0 = inactive (former employee, or account disabled). Source column: staff.active; datatype xsd:integer; NOT NULL.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#inventory_hasFilm">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/inventory/film_id"/>
    <rdfs:label xml:lang="en">inventory has Film</rdfs:label>
