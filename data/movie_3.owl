    <rdfs:comment xml:lang="en">Class generated from source table 'rental'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A rental transaction in which a customer borrows one inventory item, processed by one staff member, starting at the rental date and optionally ending at the return date. Each row of source table 'rental' is one rental.</rdfs:comment>
    <owl:disjointWith rdf:resource="http://example.org/ontology#Inventory_Customer_Staff"/>
  </rdf:Description>
