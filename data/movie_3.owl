  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#staff_staff_id">
    <rdfs:comment xml:lang="en">Data property generated from source column 'staff.staff_id' with range xsd:integer.</rdfs:comment>
    <rdfs:comment xml:lang="en">Primary key of the staff table. Surrogate integer that uniquely identifies a staff member. It is referenced by store.manager_staff_id. Source column: staff.staff_id; datatype xsd:integer; NOT NULL; PRIMARY KEY.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Staff"/>
    <rdfs:label xml:lang="en">staff id</rdfs:label>
    <rdfs:label xml:lang="en">staff identifier</rdfs:label>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/staff/staff_id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#film_rating">
    <rdfs:label xml:lang="en">rating</rdfs:label>
    <rdfs:label xml:lang="en">film rating</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'film.rating' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">The audience suitability classification of the film (column film.rating). This value is optional. It is a categorical code that is ordinal by audience restriction and typically follows MPAA-style values: G, PG, PG-13, R, NC-17. Datatype xsd:string.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film/rating"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nd25b71a03068445c822d0fbab43477ed">
    <owl:someValuesFrom rdf:resource="http://www.w3.org/2001/XMLSchema#integer"/>
    <owl:onProperty rdf:resource="http://example.org/ontology#inventory_inventory_id"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Restriction"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="Nefca8855b28c466f9af4f930a2280e87">
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
    <rdf:first rdf:resource="http://example.org/ontology#language_language_id"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#actor_last_update">
    <rdfs:label xml:lang="en">last update</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'actor.last_update' with range xsd:datetime.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp recording when the actor record was last modified. This is record-maintenance metadata rather than a descriptive attribute of the actor. Mandatory. Source column actor.last_update (NOT NULL). The range xsd:datetime is preserved from the direct mapping to avoid conflicting ranges; it is semantically intended as xsd:dateTime and should be corrected upstream in the source datatype mapping.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/actor/last_update"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Actor"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rental_return_date">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/rental/return_date"/>
    <rdfs:label xml:lang="en">return date</rdfs:label>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'rental.return_date' with range xsd:datetime.</rdfs:comment>
    <rdfs:comment xml:lang="en">Date and time at which the rented inventory item was returned. Nullable: absence of a value indicates the item has not yet been returned (open rental). Source column rental.return_date; source datatype normalized from xsd:datetime to xsd:dateTime.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Rental"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#rental_hasStaff">
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/rental/staff_id"/>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'rental.staff_id' referencing 'staff.staff_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a rental to the single staff member who processed the rental. Mandatory; derived from foreign key rental.staff_id referencing staff.staff_id.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Staff"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Rental"/>
    <rdfs:label xml:lang="en">rental has Staff</rdfs:label>
    <rdfs:label xml:lang="en">processing staff member</rdfs:label>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N21a51c0f94474324831573870476ec0f">
    <rdf:first rdf:resource="http://example.org/ontology#store_store_id"/>
    <rdf:rest rdf:resource="http://www.w3.org/1999/02/22-rdf-syntax-ns#nil"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#staff_hasStore">
    <rdfs:range rdf:resource="http://example.org/ontology#Store"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/staff/store_id"/>
    <rdfs:label xml:lang="en">staff has Store</rdfs:label>
    <rdfs:label xml:lang="en">works at store</rdfs:label>
    <rdfs:comment xml:lang="en">Object property generated from foreign key 'staff.store_id' referencing 'store.store_id'.</rdfs:comment>
    <rdfs:comment xml:lang="en">Links a staff member to the home store where they are employed. Derived from the foreign key staff.store_id, which references store.store_id. The column is NOT NULL, so every staff member is assigned to exactly one store.</rdfs:comment>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Staff"/>
  </rdf:Description>
  <rdf:Description rdf:about="http://example.org/ontology#customer_last_name">
    <rdfs:label xml:lang="en">last name</rdfs:label>
    <rdfs:label xml:lang="en">customer last name</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
    <rdfs:comment xml:lang="en">Data property generated from source column 'customer.last_name' with range xsd:string.</rdfs:comment>
    <rdfs:comment xml:lang="en">Family name (surname) of the customer (column customer.last_name; not null; datatype xsd:string).</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/customer/last_name"/>
    <rdfs:domain rdf:resource="http://example.org/ontology#Customer"/>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#string"/>
  </rdf:Description>
  <rdf:Description rdf:nodeID="N035b18454a704e00965a5bca1eaf8162">
