  <rdf:Description rdf:about="http://example.org/ontology#film_actor_last_update">
    <rdfs:domain rdf:resource="http://example.org/ontology#FilmActor"/>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film_actor/last_update"/>
    <rdfs:label xml:lang="en">last update</rdfs:label>
    <rdfs:label xml:lang="en">film actor last update</rdfs:label>
    <rdfs:comment xml:lang="en">Data property generated from source column 'film_actor.last_update' with range xsd:datetime.</rdfs:comment>
    <rdfs:comment xml:lang="en">Timestamp of the most recent modification of the casting record (column film_actor.last_update, non-nullable). This is record-maintenance metadata, not a property of the actor or film themselves. Range normalized from the non-standard 'xsd:datetime' to the valid XSD datatype xsd:dateTime.</rdfs:comment>
    <rdfs:range rdf:resource="http://www.w3.org/2001/XMLSchema#dateTime"/>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#DatatypeProperty"/>
  </rdf:Description>
