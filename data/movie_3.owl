    <rdfs:label xml:lang="en">Address</rdfs:label>
    <rdfs:comment xml:lang="en">Class generated from source table 'address'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A postal or physical location record. It contains street lines, district, postal code, phone number, and the city where the address is located. Generated from source table 'address'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A postal address. Target of the foreign key staff.address_id.</rdfs:comment>
