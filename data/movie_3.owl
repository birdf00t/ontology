    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#Class"/>
    <rdfs:comment xml:lang="en">Class generated from source table 'customer'.</rdfs:comment>
    <rdfs:comment xml:lang="en">A person registered as a customer of a store. Each customer is identified by a unique customer id, has a first and last name, an optional email address, a postal address, a home store, an active/inactive status flag, and creation and last-modification timestamps. Derived from source table 'customer'.</rdfs:comment>
