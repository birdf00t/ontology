  <rdf:Description rdf:about="http://example.org/ontology#film_hasCategory">
    <rdfs:domain rdf:resource="http://example.org/ontology#Film"/>
    <rdfs:label xml:lang="en">film has category</rdfs:label>
    <rdf:type rdf:resource="http://www.w3.org/2002/07/owl#ObjectProperty"/>
    <rdfs:range rdf:resource="http://example.org/ontology#Category"/>
    <rdfs:comment xml:lang="en">Direct many-to-many relationship between a film and a category assigned to it. It is derived from the junction table 'film_category' through the chain inverse(film_category_hasFilm) followed by film_category_hasCategory. A film may have several categories, and a category may apply to several films.</rdfs:comment>
    <prov:wasDerivedFrom rdf:resource="http://example.org/ontology/provenance/film_category"/>
  </rdf:Description>
