@prefix rr: <http://www.w3.org/ns/r2rml#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix : <http://example.org/ontology#> .
@prefix map: <http://example.org/movie_3/mapping#> .

map:TM_actor a rr:TriplesMap ;
    rr:logicalTable [ rr:tableName "actor" ] ;
    rr:subjectMap [ rr:template "http://example.org/movie_3/resource/actor/{actor_id}" ; rr:class <http://example.org/ontology#Actor> ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#actor_actor_id> ; rr:objectMap [ rr:column "actor_id" ; rr:datatype <http://www.w3.org/2001/XMLSchema#integer> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#actor_first_name> ; rr:objectMap [ rr:column "first_name" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#actor_last_name> ; rr:objectMap [ rr:column "last_name" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] .

map:TM_actor__datetime__last_update a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT \"actor_id\", replace(\"last_update\", ' ', 'T') AS \"last_update__iso\" FROM \"actor\" WHERE \"last_update\" IS NOT NULL" ] ;
    rr:subjectMap [ rr:template "http://example.org/movie_3/resource/actor/{actor_id}" ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#actor_last_update> ; rr:objectMap [ rr:column "last_update__iso" ; rr:datatype <http://www.w3.org/2001/XMLSchema#dateTime> ] ] .

