map:TM_procedures a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT *, md5(concat_ws('|', COALESCE(\"DATE\"::text, ''), COALESCE(\"PATIENT\"::text, ''), COALESCE(\"ENCOUNTER\"::text, ''), COALESCE(\"CODE\"::text, ''), COALESCE(\"DESCRIPTION\"::text, ''), COALESCE(\"REASONCODE\"::text, ''), COALESCE(\"REASONDESCRIPTION\"::text, ''))) || '_' || (row_number() OVER (PARTITION BY md5(concat_ws('|', COALESCE(\"DATE\"::text, ''), COALESCE(\"PATIENT\"::text, ''), COALESCE(\"ENCOUNTER\"::text, ''), COALESCE(\"CODE\"::text, ''), COALESCE(\"DESCRIPTION\"::text, ''), COALESCE(\"REASONCODE\"::text, ''), COALESCE(\"REASONDESCRIPTION\"::text, '')))))::text AS \"_rowid\" FROM \"procedures\"" ] ;
    rr:subjectMap [ rr:template "http://example.org/synthea/resource/procedures/{_rowid}" ; rr:class <http://example.org/ontology#Procedures> ] ;
