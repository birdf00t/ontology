map:TM_observations a rr:TriplesMap ;
    rr:logicalTable [ rr:sqlQuery "SELECT *, md5(concat_ws('|', COALESCE(\"DATE\"::text, ''), COALESCE(\"PATIENT\"::text, ''), COALESCE(\"ENCOUNTER\"::text, ''), COALESCE(\"CODE\"::text, ''), COALESCE(\"DESCRIPTION\"::text, ''), COALESCE(\"VALUE\"::text, ''), COALESCE(\"UNITS\"::text, ''))) || '_' || (row_number() OVER (PARTITION BY md5(concat_ws('|', COALESCE(\"DATE\"::text, ''), COALESCE(\"PATIENT\"::text, ''), COALESCE(\"ENCOUNTER\"::text, ''), COALESCE(\"CODE\"::text, ''), COALESCE(\"DESCRIPTION\"::text, ''), COALESCE(\"VALUE\"::text, ''), COALESCE(\"UNITS\"::text, '')))))::text AS \"_rowid\" FROM \"observations\"" ] ;
    rr:subjectMap [ rr:template "http://example.org/synthea/resource/observations/{_rowid}" ; rr:class <http://example.org/ontology#Observations> ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_DATE> ; rr:objectMap [ rr:column "\"DATE\"" ; rr:datatype <http://www.w3.org/2001/XMLSchema#date> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_hasPatients> ; rr:objectMap [ rr:template "http://example.org/synthea/resource/patients/{\"PATIENT\"}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_hasEncounters> ; rr:objectMap [ rr:template "http://example.org/synthea/resource/encounters/{\"ENCOUNTER\"}" ; rr:termType rr:IRI ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_CODE> ; rr:objectMap [ rr:column "\"CODE\"" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_DESCRIPTION> ; rr:objectMap [ rr:column "\"DESCRIPTION\"" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_VALUE> ; rr:objectMap [ rr:column "\"VALUE\"" ; rr:datatype <http://www.w3.org/2001/XMLSchema#double> ] ] ;
    rr:predicateObjectMap [ rr:predicate <http://example.org/ontology#observations_UNITS> ; rr:objectMap [ rr:column "\"UNITS\"" ; rr:datatype <http://www.w3.org/2001/XMLSchema#string> ] ] .

